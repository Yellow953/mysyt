, {"text": "year", "start": 178.185, "end": 178.565}, {"text": "to", "start": 178.565, "end": 178.925}, {"text": "keep?", "start": 178.925, "end": 179.205}]}, {"start": 179.866, "end": 184.184, "text": "You tell the voice to be quiet. It is not quiet.", "words": [{"text": "You", "start": 179.866, "end": 179.986}, {"text": "tell", "start": 179.986, "end": 180.186}, {"text": "the", "start": 180.186, "end": 180.326}, {"text": "voice", "start": 180.326, "end": 180.526}, {"text": "to", "start": 180.526, "end": 180.686}, {"text": "be", "start": 180.686, "end": 180.806}, {"text": "quiet.", "start": 180.806, "end": 181.226}, {"text": "It", "start": 182.226, "end": 182.446}, {"text": "is", "start": 182.446, "end": 182.846}, {"text": "not", "start": 182.846, "end": 183.246}, {"text": "quiet.", "start": 183.246, "end": 183.846}]}, {"start": 184.634, "end": 192.691, "text": "Here is something researchers found. A study of lottery winners in Florida looked at who went bankrupt, and when.", "words": [{"text": "Here", "start": 184.634, "end": 184.834}, {"text": "is", "start": 184.834, "end": 184.994}, {"text": "something", "start": 184.994, "end": 185.334}, {"text": "researchers", "start": 185.334, "end": 185.934}, {"text": "found.", "start": 185.934, "end": 186.534}, {"text": "A", "start": 187.734, "end": 187.814}, {"text": "study", "start": 187.814, "end": 188.034}, {"text": "of", "start": 188.034, "end": 188.234}, {"text": "lottery", "start": 188.234, "end": 188.514}, {"text": "winners", "start": 188.514, "end": 188.994}, {"text": "in", "start": 188.994, "end": 189.234}, {"text": "Florida", "start": 189.234, "end": 189.674}, {"text": "looked", "start": 189.674, "end": 190.434}, {"text": "at", "start": 190.434, "end": 190.674}, {"text": "who", "start": 190.674, "end": 190.894}, {"text": "went", "start": 190.894, "end": 191.114}, {"text": "bankrupt,", "start": 191.114, "end": 191.534}, {"text": "and", "start": 191.894, "end": 192.174}, {"text": "when.", "start": 192.174, "end": 1