, "end": 182.649}, {"text": "to", "start": 182.649, "end": 182.877}, {"text": "a", "start": 182.877, "end": 183.039}, {"text": "pump.", "start": 183.039, "end": 183.656}, {"text": "It", "start": 183.656, "end": 183.884}, {"text": "stalls,", "start": 183.884, "end": 184.631}, {"text": "and", "start": 184.631, "end": 184.923}, {"text": "you", "start": 184.923, "end": 185.216}, {"text": "fly", "start": 185.216, "end": 185.508}, {"text": "over", "start": 185.508, "end": 185.866}, {"text": "the", "start": 185.866, "end": 186.158}, {"text": "handlebars.", "start": 186.158, "end": 187.165}]}, {"start": 187.665, "end": 192.145, "text": "Real plants run on fuel and power, not your legs.", "words": [{"text": "Real", "start": 187.665, "end": 188.069}, {"text": "plants", "start": 188.069, "end": 188.62}, {"text": "run", "start": 188.62, "end": 188.95}, {"text": "on", "start": 188.95, "end": 189.207}, {"text": "fuel", "start": 189.207, "end": 189.611}, {"text": "and", "start": 189.611, "end": 189.942}, {"text": "power,", "start": 189.942, "end": 190.713}, {"text": "not", "start": 190.713, "end": 191.043}, {"text": "your", "start": 191.043, "end": 191.447}, {"text": "legs.", "start": 191.447, "end": 192.145}]}, {"start": 192.745, "end": 205.613, "text": "Brine, the leftover, can harm the sea. Saudi Arabia, the UAE, Kuwait and Qatar make more than half the world's brine, by a 2019 study.", "words": [{"text": "Brine,", "start": 192.745, "end": 193.552}, {"text": "the", "start": 193.552, "end": 193.897}, {"text": "leftover,", "start": 193.897, "end": 194.934}, {"text": "can", "start": 194.934, "end": 195.28}, {"text": "harm", "start": 195.28, "end": 195.703}, {"text": "the", "start": 195.703, "end": 196.048}, {"text": "sea.", "start": 196.048, "end": 196.701}, {"text": "Saudi", "start": 196.701, "end": 197.201}, {"text": "Arabia,", "start": 197.201, "end": 198.084}, {"text": "the", "start": 198.084, "end": 198.43}, {"text": "UAE,", "start": 198.43, "end": 199.083}, {"text": "Kuwait"