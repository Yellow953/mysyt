d": 18.425}, {"text": "Big", "start": 18.425, "end": 18.791}, {"text": "mistake.", "start": 18.791, "end": 19.809}]}, {"start": 20.409, "end": 32.889, "text": "Seawater is roughly 3.5 percent salt. Your blood is under 1 percent. You spit it out, in slow motion, like a sports replay.", "words": [{"text": "Seawater", "start": 20.409, "end": 21.202}, {"text": "is", "start": 21.202, "end": 21.494}, {"text": "roughly", "start": 21.494, "end": 22.204}, {"text": "3.5", "start": 22.204, "end": 22.496}, {"text": "percent", "start": 22.496, "end": 23.206}, {"text": "salt.", "start": 23.206, "end": 23.999}, {"text": "Your", "start": 23.999, "end": 24.458}, {"text": "blood", "start": 24.458, "end": 25.0}, {"text": "is", "start": 25.0, "end": 25.292}, {"text": "under", "start": 25.292, "end": 25.835}, {"text": "1", "start": 25.835, "end": 26.044}, {"text": "percent.", "start": 26.044, "end": 27.087}, {"text": "You", "start": 27.087, "end": 27.463}, {"text": "spit", "start": 27.463, "end": 27.922}, {"text": "it", "start": 27.922, "end": 28.214}, {"text": "out,", "start": 28.214, "end": 28.924}, {"text": "in", "start": 28.924, "end": 29.216}, {"text": "slow", "start": 29.216, "end": 29.675}, {"text": "motion,", "start": 29.675, "end": 30.635}, {"text": "like", "start": 30.635, "end": 31.094}, {"text": "a", "start": 31.094, "end": 31.303}, {"text": "sports", "start": 31.303, "end": 31.929}, {"text": "replay.", "start": 31.929, "end": 32.889}]}, {"start": 33.389, "end": 41.76, "text": "Your kidneys can concentrate urine only a little beyond seawater's saltiness. And they also have to flush out your body's own waste.", "words": [{"text": "Your", "start": 33.389, "end": 33.7}, {"text": "kidneys", "start": 33.7, "end": 34.181}, {"text": "can", "start": 34.181, "end": 34.435}, {"text": "concentrate", "start": 34.435, "end": 35.142}, {"text": "urine", "start": 35.142, "end": 35.51}, {"text": "only", "start": 35.51, "end": 35.821}, {"text": "a", "start": 35.821, "end": 35.963}, {"text": "