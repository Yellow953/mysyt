[
 {
  "text": "Other apes wake up dressed.",
  "start": 0.0,
  "end": 1.846
 },
 {
  "text": "You lost your fur.",
  "start": 2.246,
  "end": 3.217
 },
 {
  "text": "Scientists still argue why.",
  "start": 3.617,
  "end": 6.1
 },
 {
  "text": "Around one to two million years ago, we shed most of it.",
  "start": 6.6,
  "end": 10.522
 },
 {
  "text": "Maybe sweating. Maybe parasites. Nobody wrote it down.",
  "start": 11.022,
  "end": 15.422
 },
 {
  "text": "Then winter happened.",
  "start": 15.872,
  "end": 17.858
 },
 {
  "text": "By four hundred thousand years ago, someone was scraping hides.",
  "start": 18.408,
  "end": 23.226
 },
 {
  "text": "Not me.",
  "start": 23.526,
  "end": 24.215
 },
 {
  "text": "Lice DNA hints clothes existed by about a hundred thousand years ago.",
  "start": 25.015,
  "end": 29.815
 },
 {
  "text": "The lice moved in. Rent-free.",
  "start": 30.215,
  "end": 33.748
 },
 {
  "text": "A 2024 study links eyed needles to fitted, decorated clothes.",
  "start": 34.298,
  "end": 39.877
 },
 {
  "text": "Survival gear became a statement.",
  "start": 40.377,
  "end": 43.228
 },
 {
  "text": "Mine says: tired.",
  "start": 43.578,
  "end": 45.362
 },
 {
  "text": "Would you take the fur back?",
  "start": 45.912,
  "end": 47.924
 },
 {
  "text": "Tell me below.",
  "start": 48.274,
  "end": 49.105
 }
]