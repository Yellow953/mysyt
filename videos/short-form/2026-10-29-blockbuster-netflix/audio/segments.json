[
 {
  "text": "You run Blockbuster. It's 2000.",
  "start": 0.0,
  "end": 4.034
 },
 {
  "text": "Two nervous guys offer you Netflix. Fifty million dollars.",
  "start": 4.384,
  "end": 9.984
 },
 {
  "text": "One of them says you fought back a laugh.",
  "start": 10.384,
  "end": 12.525
 },
 {
  "text": "You say no.",
  "start": 13.025,
  "end": 14.561
 },
 {
  "text": "Ten years later, you're bankrupt.",
  "start": 15.061,
  "end": 17.43
 },
 {
  "text": "Their company mailed DVDs in little envelopes.",
  "start": 18.13,
  "end": 22.182
 },
 {
  "text": "Yours had thousands of stores. And late fees.",
  "start": 22.582,
  "end": 26.873
 },
 {
  "text": "Then everybody started streaming.",
  "start": 27.373,
  "end": 29.535
 },
 {
  "text": "Netflix is still here.",
  "start": 30.035,
  "end": 31.568
 },
 {
  "text": "By 2019, one Blockbuster was left. In Oregon.",
  "start": 32.168,
  "end": 36.82
 },
 {
  "text": "Tourists visit it like a museum.",
  "start": 37.22,
  "end": 39.527
 },
 {
  "text": "To be fair, everyone was nuts in 2000.",
  "start": 40.127,
  "end": 43.138
 },
 {
  "text": "Your no was just expensive.",
  "start": 43.538,
  "end": 45.32
 },
 {
  "text": "Be honest. You'd have said no too?",
  "start": 46.02,
  "end": 48.377
 }
]