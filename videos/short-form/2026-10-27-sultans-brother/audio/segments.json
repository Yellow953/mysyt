[
 {
  "text": "You're the sultan's little brother.",
  "start": 0.0,
  "end": 1.747
 },
 {
  "text": "Dad died.",
  "start": 2.047,
  "end": 3.83
 },
 {
  "text": "Lose the race to Istanbul, get a polite visit.",
  "start": 4.13,
  "end": 8.13
 },
 {
  "text": "First to Istanbul usually wins.",
  "start": 8.58,
  "end": 11.342
 },
 {
  "text": "In 1481, your brother Bayezid beat you to Istanbul.",
  "start": 11.742,
  "end": 15.925
 },
 {
  "text": "You flee abroad. Smart.",
  "start": 16.225,
  "end": 18.465
 },
 {
  "text": "For a while.",
  "start": 19.065,
  "end": 20.861
 },
 {
  "text": "The Conqueror's law: brothers can be removed. Officially, for order.",
  "start": 21.261,
  "end": 27.48
 },
 {
  "text": "In 1595, your brother Mehmed the Third takes the throne. You're one of nineteen.",
  "start": 27.88,
  "end": 34.944
 },
 {
  "text": "Basically day one.",
  "start": 35.394,
  "end": 37.234
 },
 {
  "text": "Ahmed the First spares his brother.",
  "start": 37.834,
  "end": 40.694
 },
 {
  "text": "Later, sultans mostly cage brothers instead.",
  "start": 40.994,
  "end": 44.382
 },
 {
  "text": "Free rooms. No exit.",
  "start": 44.782,
  "end": 47.262
 },
 {
  "text": "Honestly? Usually, take the cage.",
  "start": 47.662,
  "end": 50.535
 },
 {
  "text": "Run, or take the cage?",
  "start": 50.935,
  "end": 53.655
 }
]