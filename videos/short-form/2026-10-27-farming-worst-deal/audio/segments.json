[
 {
  "text": "Farming: worst deal in history?",
  "start": 0.0,
  "end": 2.88
 },
 {
  "text": "Some of your ancestors spent fifteen hours a week finding food.",
  "start": 3.35,
  "end": 7.583
 },
 {
  "text": "Free food that stays put!",
  "start": 7.883,
  "end": 10.123
 },
 {
  "text": "Finally, a job that doesn't require walking.",
  "start": 10.503,
  "end": 13.543
 },
 {
  "text": "What could go wrong?",
  "start": 13.803,
  "end": 14.974
 },
 {
  "text": "Everything.",
  "start": 15.444,
  "end": 16.125
 },
 {
  "text": "Greek skeletons suggest men shrank from about five-nine to five-three.",
  "start": 16.505,
  "end": 21.899
 },
 {
  "text": "Crops fail.",
  "start": 22.319,
  "end": 23.613
 },
 {
  "text": "Crowds spread disease.",
  "start": 23.873,
  "end": 26.327
 },
 {
  "text": "Grain needs guarding.",
  "start": 26.797,
  "end": 28.445
 },
 {
  "text": "Meet your first boss.",
  "start": 28.745,
  "end": 30.985
 },
 {
  "text": "Congratulations on the promotion.",
  "start": 31.365,
  "end": 33.075
 },
 {
  "text": "Of him.",
  "start": 33.375,
  "end": 33.991
 },
 {
  "text": "Fair point: add cooking and tool-making,",
  "start": 34.501,
  "end": 37.867
 },
 {
  "text": "and foragers worked about forty hours too.",
  "start": 38.077,
  "end": 40.538
 },
 {
  "text": "But usually no boss.",
  "start": 40.918,
  "end": 42.702
 },
 {
  "text": "No Monday.",
  "start": 42.962,
  "end": 44.305
 },
 {
  "text": "One famous scientist called farming the worst mistake in history.",
  "start": 44.775,
  "end": 49.254
 },
 {
  "text": "You still work forty.",
  "start": 49.674,
  "end": 51.074
 },
 {
  "text": "Same hours.",
  "start": 51.334,
  "end": 52.277
 },
 {
  "text": "Worse deal.",
  "start": 52.537,
  "end": 53.805
 },
 {
  "text": "Would you take the fifteen-hour week?",
  "start": 54.395,
  "end": 56.994
 },
 {
  "text": "Tell me below.",
  "start": 57.294,
  "end": 58.075
 }
]